{
  "name": "nx-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:brn": "nx serve brainiacs",
    "build:brn": "nx build brainiacs",
    "watch:brn": "nx build brainiacs --watch --configuration development",
    "test:brn": "nx test brainiacs",
    "e2e:brn": "nx e2e brainiacs-e2e",
    "start:klg": "nx serve invoice-generator",
    "build:klg": "nx build invoice-generator",
    "watch:klg": "nx build invoice-generator --watch --configuration development",
    "test:klg": "nx test invoice-generator",
    "build": "nx run-many --target=build",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test",
    "e2e": "nx run-many --target=e2e",
    "test:affected": "nx affected --target=test",
    "e2e:affected": "nx affected --target=e2e",
    "lint": "nx run-many --target=lint",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --fix",
    "lint:fix:affected": "nx affected --target=lint --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "graph:affected": "nx affected:graph",
    "test:coverage": "npx nx run-many --target=test --all --coverage",
    "sonar": "npm run test:coverage && npx sonar-scanner",
    "prepare": "husky"
  },
  "private": true,
